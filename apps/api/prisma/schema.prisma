generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        FinancialProfile?
  subscriptions  Subscription[]
  settings       UserSettings?
  scoreSnapshots ScoreSnapshot[]
  cancelIntents  CancelIntent[]
}

model FinancialProfile {
  id        String   @id @default(uuid())
  clientId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyIncomeCents Int
  cardLimitCents     Int? // opcional no MVP
  cardDueDay         Int? // opcional no MVP

  fixedExpenses FixedExpense[]

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FixedExpense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name        String
  amountCents Int

  profileId String
  profile   FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId    String
  name        String
  amountCents Int
  billingDay  Int // 1..31
  isActive    Boolean @default(true)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cancelIntents CancelIntent[]

  @@index([clientId])
}

model UserSettings {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId                  String @unique
  subscriptionsThresholdPct Int    @default(10) // 10 = 10%
  upcomingBillingWindowDays Int    @default(5) // 5 dias

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ScoreSnapshot {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId String
  score    Int
  level    String

  // Guardar “por que” o score foi assim (útil p/ trend explicável)
  drivers Json
  context Json

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model CancelIntent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId       String
  subscriptionId String
  reason         String?

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([subscriptionId])
}

model ActionLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId String
  type     String
  payload  Json?

  @@index([clientId, createdAt])
}

model Alert {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId String
  type     String
  severity String // "info" | "warning" | "danger"
  title    String
  message  String
  isActive Boolean @default(true)

  // opcional: para guardar itens (ex: lista de assinaturas) ou metadados
  payload Json?

  @@index([clientId, isActive])
  @@index([clientId, type])
}
