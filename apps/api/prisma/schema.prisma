generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile        FinancialProfile?
  subscriptions  Subscription[]
  settings       UserSettings?
  scoreSnapshots ScoreSnapshot[]
  cancelIntents  CancelIntent[]
  actionLogs     ActionLog[]
  outcomes       Outcome[]
}

model FinancialProfile {
  id        String   @id @default(uuid())
  clientId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  monthlyIncomeCents Int
  cardLimitCents     Int?
  cardDueDay         Int?

  fixedExpenses FixedExpense[]

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model FixedExpense {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name        String
  amountCents Int

  profileId String
  profile   FinancialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Subscription {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId    String
  name        String
  amountCents Int
  billingDay  Int
  isActive    Boolean @default(true)

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cancelIntents CancelIntent[]

  @@index([clientId])
}

model UserSettings {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId                  String @unique
  subscriptionsThresholdPct Int    @default(10)
  upcomingBillingWindowDays Int    @default(5)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ScoreSnapshot {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId String
  score    Int
  level    String

  drivers Json
  context Json

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

model CancelIntent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId       String
  subscriptionId String
  reason         String?

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([subscriptionId])
}

model ActionLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  clientId String
  type     String
  payload  Json?

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  outcomes Outcome[]

  @@index([clientId, createdAt])
}

model Alert {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientId    String
  type        String
  severity    String
  title       String
  message     String
  isActive    Boolean   @default(true)
  isRead      Boolean   @default(false)
  readAt      DateTime?
  dismissedAt DateTime?

  payload Json?

  @@index([clientId, isActive])
  @@index([clientId, type])
}

enum OutcomeStatus {
  PENDING
  MEASURED
  PARTIAL
  MISSED
}

enum OutcomeSourceType {
  CONFIRM_CANCELLATION
  MANUAL_ADJUSTMENT
  ALERT_DISMISS
  OTHER
}

model Outcome {
  id                   String            @id @default(uuid())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  clientId             String
  actionLogId          String?

  sourceType           OutcomeSourceType
  sourceReferenceId    String?

  title                String
  description          String?

  expectedScoreDelta   Int               @default(0)
  actualScoreDelta     Int?

  expectedSavingsCents Int               @default(0)
  actualSavingsCents   Int?

  baselineScore        Int?
  measuredScore        Int?

  status               OutcomeStatus     @default(PENDING)

  expectedAt           DateTime?
  measuredAt           DateTime?

  client               Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actionLog            ActionLog?        @relation(fields: [actionLogId], references: [id], onDelete: SetNull)

  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([actionLogId])
}